{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "gas",
      "camelcase": "GnuAssembler",
      "title": "GNU Assembler (as)",
      "scope": "source.gas",
      "file-types": [
        "s"
      ],
      "injection-regex": "^gas$",
      "class-name": "TreeSitterGas",
      "injections": "queries/injections.scm",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "GPLv3",
    "description": "Parses GNU Assembler (as) syntax.",
    "authors": [
      {
        "name": "Cyrill Schenkel",
        "email": "cyrill.schenkel@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/sirius94/tree-sitter-gas"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
